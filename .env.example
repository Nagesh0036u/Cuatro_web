# Copy this file to ".env" and edit. NEVER commit the real .env file.

NODE_ENV=development
PORT=3000
# Public URL of the site (used in password-reset links)
SITE_URL=http://localhost:3000

# --- Initial administrator (created on first start / by "npm run setup") ---
# Choose your own strong password (min 10 characters, letters and numbers). Remove it from .env after first start if you wish.
ADMIN_EMAIL=hr@cuatrotechsolutions.com
ADMIN_PASSWORD=
ADMIN_NAME=Cuatro Administrator

# --- Storage (paths are relative to the project folder unless absolute) ---
DATABASE_PATH=data/cuatro.sqlite
# Resumes are stored here, OUTSIDE the public web root, and served only through authorised routes.
RESUME_DIR=storage/resumes
MAX_RESUME_MB=5

# --- Sessions / security ---
SESSION_HOURS=12
# Set to true in production when the site is served over HTTPS
COOKIE_SECURE=false
# Set to true when running behind a reverse proxy (nginx, Cloudflare, etc.)
TRUST_PROXY=false
BCRYPT_ROUNDS=12

# --- E-mail (optional). Without SMTP, contact messages are still saved and visible in the Admin Portal;
# password-reset links are printed to the server console in development only. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Cuatro Tech Solutions <hr@cuatrotechsolutions.com>
CONTACT_INBOX=hr@cuatrotechsolutions.com

# Set to false to skip the demonstration jobs during "npm run setup"
SEED_DEMO_JOBS=true
