# Copy this file to ".env" and edit. NEVER commit the real .env file.

NODE_ENV=development
PORT=3000
# Public URL of the site (used in password-reset links)
SITE_URL=http://localhost:3000

# --- Initial administrator (created on first start / by "npm run setup") ---
# Choose your own strong password (min 10 characters, letters and numbers). Remove it from .env after first start if you wish.
ADMIN_EMAIL=hr@cuatrotechsolutions.com
ADMIN_PASSWORD=
ADMIN_NAME=Cuatro Administrator

# --- Storage (paths are relative to the project folder unless absolute) ---
DATABASE_PATH=data/cuatro.sqlite
# Resumes are stored here, OUTSIDE the public web root, and served only through authorised routes.
RESUME_DIR=storage/resumes
MAX_RESUME_MB=5

# --- Sessions / security ---
SESSION_HOURS=12
# Set to true in production when the site is served over HTTPS
COOKIE_SECURE=false
# Set to true when running behind a reverse proxy (nginx, Cloudflare, etc.)
TRUST_PROXY=false
BCRYPT_ROUNDS=12

# --- E-mail: REQUIRED for student sign-up verification codes and password reset links. ---
# Option A (works everywhere, including Render free): Brevo HTTP API. Create a free account at brevo.com,
# verify your sender address, then create an API key (SMTP & API > API keys) and paste it here.
BREVO_API_KEY=
# Option B (local computer / paid hosting): SMTP, e.g. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_SECURE=true, SMTP_USER=your@gmail.com, SMTP_PASS=<16-character Google App Password>.
# Without any mail service, codes and links are printed in the server terminal (development only);
# in production sign-up and password reset are refused until e-mail is configured.
# Reject sign-up addresses whose domain has no mail server (DNS MX check). Set to false only if DNS is unavailable.
EMAIL_VERIFY_MX=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Must be an address you verified with Brevo, or your SMTP login address for Gmail.
MAIL_FROM=Cuatro Tech Solutions <hr@cuatrotechsolutions.com>
CONTACT_INBOX=hr@cuatrotechsolutions.com

# Set to false to skip the demonstration jobs during "npm run setup"
SEED_DEMO_JOBS=true
